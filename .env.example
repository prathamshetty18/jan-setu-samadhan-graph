# ========================================================
# JAN SETU | SAMADHAN-GRAPH ENVIRONMENT CONFIGURATION
# ========================================================
# Copy this file to .env and customize values for your deployment.
# NEVER commit the real .env file with secrets to Git.

# --------------------------------------------------------
# 1. Database Configuration
# --------------------------------------------------------
# Local standalone development defaults to SQLite:
# DATABASE_URL=sqlite:///./samadhan_graph.db
#
# Production / Docker Compose (PostgreSQL + PostGIS):
DATABASE_URL=postgresql://postgres_user:your_secure_password@localhost:5432/samadhan_graph

# Docker Compose PostgreSQL settings
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=samadhan_graph

# --------------------------------------------------------
# 2. Backend API Configuration (FastAPI)
# --------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --------------------------------------------------------
# 3. AI / Multilingual NLP Configuration
# --------------------------------------------------------
# Model identifier for multilingual semantic embeddings
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
COSINE_SIMILARITY_THRESHOLD=0.75
# Set to 'true' to load heavy PyTorch transformer model locally; defaults to lightweight civic semantic projection
ENABLE_HEAVY_TRANSFORMER=false

# --------------------------------------------------------
# 4. Frontend Configuration (Vite + React)
# --------------------------------------------------------
VITE_API_URL=http://localhost:8000
